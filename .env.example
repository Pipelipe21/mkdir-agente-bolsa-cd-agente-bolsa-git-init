# Copiar a .env y completar. NUNCA commitear .env.

# Modo de ejecución: alert | backtest | paper | live (fase 1: alert).
# Si no se define, el código usa paper.
# `live` solo se activa si además LIVE_TRADING_ENABLED=true
EXECUTION_MODE=alert
LIVE_TRADING_ENABLED=false

# Telegram (fase 1)
TELEGRAM_BOT_TOKEN=changeme
TELEGRAM_CHAT_ID=changeme

# Claude API (resúmenes de noticias / explicación de alertas)
ANTHROPIC_API_KEY=changeme

# Supabase (Postgres). Ver docs/supabase.md para obtener la URI.
# Si no se define, el radar funciona igual pero sin historial ni deduplicación.
DATABASE_URL=postgresql://postgres.changeme:changeme@aws-0-changeme.pooler.supabase.com:5432/postgres

# Exchanges (fase 2+). Llaves SIN permiso de retiro.
ALPACA_API_KEY=changeme
ALPACA_API_SECRET=changeme
BINANCE_TESTNET_API_KEY=changeme
BINANCE_TESTNET_API_SECRET=changeme
